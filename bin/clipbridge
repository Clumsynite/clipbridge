#!/bin/zsh
# clipbridge: make the Mac clipboard readable from SSH sessions.
#
#   clipbridge install            build ClipBridge.app, start it at login, link this CLI
#   clipbridge add <alias> [--also <ip>]...   set up an ssh host (forward, remote shims, PATH);
#                                 --also: other names/IPs you ssh to for the same box
#   clipbridge remove <alias>     undo add
#   clipbridge rotate <alias>|--all   new session keys (open sessions must reconnect)
#   clipbridge doctor [alias]     check everything end to end
#   clipbridge pause | resume     stop / start serving the clipboard
#   clipbridge status             app state, pause state, configured hosts
#   clipbridge version
set -euo pipefail

ROOT=${0:A:h:h}
LABEL=com.clumsyknight.clipbridge
APP=$HOME/Applications/ClipBridge.app
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
CONF=$HOME/.config/clipbridge
HOSTS=$CONF/hosts
SSHCONF=$HOME/.ssh/config
MAC_PORT=7788
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10)
SCP=(scp -q -o BatchMode=yes -o ConnectTimeout=10)

die() { print -u2 "clipbridge: $*"; exit 1; }
say() { print "clipbridge: $*"; }
host_file() { print "$HOSTS/$1.json"; }
json_get() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"; }

app_running() { pgrep -qx ClipBridge; }

# ---------------------------------------------------------------- install

cmd_install() {
  if [[ -d $ROOT/ClipBridge.app ]]; then
    # Release kit: use the prebuilt app. A downloaded zip is quarantined; this is your own install.
    mkdir -p "${APP:h}"
    rm -rf "$APP"
    ditto "$ROOT/ClipBridge.app" "$APP"
    xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
  else
    # Source checkout: build it (needs Xcode / Swift 6).
    local bundled
    bundled=$("$ROOT/scripts/bundle.sh")
    [[ $bundled == "$APP" ]] || die "bundle step failed"
  fi
  mkdir -p "${PLIST:h}"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$APP/Contents/MacOS/ClipBridge</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  pkill -x ClipBridge 2>/dev/null || true
  sleep 1
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  mkdir -p "$HOME/.local/bin"
  mkdir -p -m 700 "$CONF" "$HOSTS"
  chmod 700 "$CONF" "$HOSTS"
  ln -sf "$ROOT/bin/clipbridge" "$HOME/.local/bin/clipbridge"
  sleep 1
  launchctl print "gui/$(id -u)/$LABEL" | grep -q 'state = running' || die "agent didn't start; see ~/Library/Logs/clipbridge.log"
  say "installed; ClipBridge is running (menu bar)"
}

# ---------------------------------------------------------------- ssh config
#
# ~/.ssh/config gets one marked block that includes ~/.config/clipbridge/ssh_config (0600). That
# file holds a Host block per set-up host, including its session key (SetEnv LC_CLIPBRIDGE=…), so
# the key never sits in the world-readable ~/.ssh/config and never on the remote box's disk.

INCLUDE=$CONF/ssh_config

# The file without any clipbridge block (current single block, or older per-host ones).
strip_ours() {
  awk '/^# clipbridge begin/ { skip = 1; next } /^# clipbridge end/ { skip = 0; next } !skip' "$1"
}

# Pre-existing settings we'd fight with, outside our block.
foreign_settings() {
  awk '
    /^# clipbridge begin/ { skip = 1; next }
    /^# clipbridge end/ { skip = 0; next }
    !skip && tolower($0) ~ /^[ \t]*(controlmaster|controlpath|controlpersist|remoteforward)[ \t=]/ { print NR": "$0 }' "$SSHCONF"
}

# Regenerate the include file from hosts/*.json.
write_include() {
  mkdir -p -m 700 "$CONF"
  python3 - "$HOSTS" "$INCLUDE" "$MAC_PORT" <<'PY'
import glob, json, os, sys
hosts_dir, out, mac_port = sys.argv[1:4]
parts = ["# Generated by clipbridge: holds per-host session keys. Keep it 0600; don't edit by hand.\n"]
for path in sorted(glob.glob(os.path.join(hosts_dir, "*.json"))):
    h = json.load(open(path))
    names = []
    for n in [h["host"]] + list(h.get("names_added", {})) + h.get("also", []):
        if n not in names:
            names.append(n)
    parts.append(
        "\nHost %s\n"
        "  RemoteForward 127.0.0.1:%d 127.0.0.1:%s\n"
        "  ControlMaster auto\n"
        "  ControlPath ~/.ssh/cm/%%C\n"
        "  ControlPersist 10m\n"
        "  ServerAliveInterval 15\n"
        "  ServerAliveCountMax 3\n"
        "  SetEnv LC_CLIPBRIDGE=v1:%s:%d:%s\n"
        % (" ".join(names), h["port"], mac_port, h["host"], h["port"], h["token_hex"]))
tmp = out + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("".join(parts))
os.chmod(tmp, 0o600)
os.replace(tmp, out)
PY
}

# Make ~/.ssh/config contain exactly our include block (want=1) or none (want=0).
# Backs the file up only when it actually changes.
sync_ssh_config() {
  local want=$1 tmp
  tmp=$(mktemp)
  strip_ours "$SSHCONF" > "$tmp"
  if (( want )); then
    [[ -s $tmp && -n $(tail -c1 "$tmp") ]] && print >> "$tmp"
    print -r -- '# clipbridge begin' >> "$tmp"
    print -r -- 'Match all' >> "$tmp"
    print -r -- 'Include ~/.config/clipbridge/ssh_config' >> "$tmp"
    print -r -- '# clipbridge end' >> "$tmp"
  fi
  if ! cmp -s "$tmp" "$SSHCONF"; then
    cp -p "$SSHCONF" "$SSHCONF.bak-clipbridge-$(date +%Y%m%d-%H%M%S)"
    cat "$tmp" > "$SSHCONF"
  fi
  rm -f "$tmp"
}

hosts_count() { local -a f; f=("$HOSTS"/*.json(N)); print ${#f}; }

# ---------------------------------------------------------------- remote rc block

rc_file_for() {
  case ${1:t} in
    zsh) print .zshrc ;;
    bash) print .bashrc ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------- add

cmd_add() {
  local alias=${1:?usage: clipbridge add <alias> [--also <host-or-ip>]...}
  shift
  local -a also=()
  while (( $# )); do
    case $1 in
      --also) [[ -n ${2:-} ]] || die "--also needs a host or IP"; also+=("$2"); shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  local n
  for n in $also; do [[ $n =~ '^[A-Za-z0-9._:-]+$' ]] || die "bad --also name: $n"; done
  [[ $alias =~ '^[A-Za-z0-9._-]+$' ]] || die "alias must be letters, digits, . _ -"
  [[ -f $SSHCONF ]] || die "no $SSHCONF"
  local foreign
  foreign=$(foreign_settings)
  [[ -z $foreign ]] || die "ssh config already sets ControlMaster/ControlPath/ControlPersist/RemoteForward; resolve first:
$foreign"

  say "checking $alias"
  local info
  info=$("${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$alias" 'printf "shell=%s\n" "$SHELL"; command -v python3 >/dev/null && echo python3=yes; for n in clipbridge-shim xclip xsel pbpaste; do f="$HOME/.local/bin/$n"; if [ -L "$f" ]; then echo "link $n $(readlink "$f")"; elif [ -e "$f" ]; then echo "file $n"; fi; done; ss -ltn 2>/dev/null | awk "NR>1{print \"port \" \$4}"; for a in $(hostname -I 2>/dev/null); do case $a in *:*) ;; *) echo "ip $a" ;; esac; done') \
    || die "can't reach $alias non-interactively (needs key auth)"
  [[ $info == *python3=yes* ]] || die "$alias has no python3"
  local rshell rc
  rshell=$(print -r -- "$info" | sed -n 's/^shell=//p')
  rc=$(rc_file_for "$rshell") || die "remote shell $rshell not supported (zsh or bash)"
  local conflicts
  conflicts=$(print -r -- "$info" | awk '$1=="file" && $2!="clipbridge-shim" {print $2} $1=="link" && $3!="clipbridge-shim" {print $2}')
  [[ -z $conflicts ]] || die "$alias already has these in ~/.local/bin (not ours): ${(f)conflicts}"

  mkdir -p -m 700 "$HOSTS"
  local hf port token
  hf=$(host_file "$alias")
  local names=""
  if [[ -f $hf ]]; then
    port=$(json_get "$hf" port)
    token=$(json_get "$hf" token_hex)
    names=$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1])).get("also", [])))' "$hf")
  else
    local used
    used=$(print -r -- "$info" | sed -n 's/^port .*:\([0-9]*\)$/\1/p')
    for _ in {1..50}; do
      port=$(( 20000 + RANDOM % 12768 ))
      print -r -- "$used" | grep -qx "$port" || break
    done
    token=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
  fi

  local backup=$SSHCONF.bak-clipbridge-$(date +%Y%m%d-%H%M%S)
  cp -p "$SSHCONF" "$backup"
  local created_host=0 hf_backup=""
  if [[ -f $hf ]]; then hf_backup=$(mktemp); cp -p "$hf" "$hf_backup"; else created_host=1; fi
  rollback() {
    say "failed; restoring $SSHCONF from $backup"
    cp -p "$backup" "$SSHCONF"
    if (( created_host )); then rm -f "$hf"; elif [[ -n $hf_backup ]]; then cp -p "$hf_backup" "$hf"; fi
    write_include 2>/dev/null || true
  }
  trap 'rollback' ZERR
  trap - ERR

  for n in $also; do [[ " $names " == *" $n "* ]] || names+=" $n"; done
  names=${names# }
  local ips hn
  ips=$(print -r -- "$info" | sed -n 's/^ip //p' | tr '\n' ' ')
  hn=$(ssh -G "$alias" 2>/dev/null | awk '$1 == "hostname" { print $2 }')
  # Host JSON (Mac only, 0600). Besides the token: which names the ssh block matches and since
  # when (names_added), and the box's own IPv4 addresses (ips), so the app can spot an ssh
  # session that reached this box by a name the block doesn't match.
  (umask 077; python3 - "$hf" "$alias" "$port" "$token" "$names" "$ips" "$hn" <<'PY'
import json, os, sys, time
hf, alias, port, token, also, ips, hn = sys.argv[1:8]
old = {}
if os.path.exists(hf):
    try:
        old = json.load(open(hf))
    except ValueError:
        pass
now = int(time.time())
matched = [alias] + ([hn] if hn and hn != alias else []) + also.split()
names_added = {n: t for n, t in old.get("names_added", {}).items() if n in matched}
for n in matched:
    names_added.setdefault(n, now)
json.dump({
    "host": alias, "port": int(port), "token_hex": token,
    "also": also.split(), "ips": ips.split(),
    "added": old.get("added", now), "names_added": names_added,
    "rotated": old.get("rotated", now),
}, open(hf, "w"), indent=2)
PY
  )
  write_include
  sync_ssh_config 1
  mkdir -p -m 700 "$HOME/.ssh/cm"
  # No need to restart an existing ControlMaster: each new session reads the include file and sends
  # the current key itself. (Exiting the master would also close every open session on it.)

  "${SSH[@]}" "$alias" 'mkdir -p ~/.local/bin'
  "${SCP[@]}" "$ROOT/remote/clipbridge-shim" "$ROOT/remote/clipbridge-attach" "$alias:.local/bin/"
  # Key on disk from older versions: remove it. The key now only travels in your sessions' env.
  "${SSH[@]}" "$alias" 'cd ~/.local/bin && chmod 755 clipbridge-shim clipbridge-attach && for n in xclip xsel pbpaste; do ln -sfn clipbridge-shim "$n"; done; rm -f ~/.config/clipbridge/config.json; rmdir ~/.config/clipbridge 2>/dev/null; true'
  "${SSH[@]}" "$alias" "f=~/$rc; touch \$f; awk '/^# clipbridge begin\$/{s=1;next} /^# clipbridge end\$/{s=0;next} !s' \$f > \$f.cb-tmp && cat \$f.cb-tmp > \$f && rm \$f.cb-tmp && printf '\n# clipbridge begin\nexport PATH=\"\$HOME/.local/bin:\$PATH\"\n# clipbridge end\n' >> \$f"

  trap - ZERR
  [[ -n $hf_backup ]] && rm -f "$hf_backup"
  local others="" a
  for a in ${=ips}; do [[ " $alias $hn $names " == *" $a "* ]] || others+=" $a"; done
  say "added $alias (remote port $port). Open a new ssh session, then run: clipbridge doctor $alias"
  [[ -n $others ]] && print "other-ips:$others" && say "if you also ssh to it as${others}, run: clipbridge add $alias --also <ip>"
  return 0
}

# ---------------------------------------------------------------- remove

cmd_remove() {
  local alias=${1:?usage: clipbridge remove <alias>}
  local hf port=""
  hf=$(host_file "$alias")
  [[ -f $hf ]] && port=$(json_get "$hf" port)
  if [[ -n $port ]]; then
    "${SSH[@]}" -O cancel -R "127.0.0.1:$port:127.0.0.1:$MAC_PORT" "$alias" 2>/dev/null || true
  fi
  "${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$alias" 'cd ~/.local/bin 2>/dev/null && for n in xclip xsel pbpaste; do [ -L "$n" ] && [ "$(readlink "$n")" = clipbridge-shim ] && rm -f "$n"; done; rm -f ~/.local/bin/clipbridge-shim ~/.local/bin/clipbridge-attach; rm -rf ~/.config/clipbridge; for f in ~/.zshrc ~/.bashrc; do [ -f "$f" ] && awk "/^# clipbridge begin\$/{s=1;next} /^# clipbridge end\$/{s=0;next} !s" "$f" > "$f.cb-tmp" && cat "$f.cb-tmp" > "$f" && rm "$f.cb-tmp"; done; true' \
    || say "warning: couldn't clean up $alias remotely"
  rm -f "$hf"
  if (( $(hosts_count) )); then
    write_include
    sync_ssh_config 1
  else
    sync_ssh_config 0
    rm -f "$INCLUDE"
  fi
  say "removed $alias"
}

# ---------------------------------------------------------------- rotate

# New session keys. Mac-only: new ssh sessions pick the key up from the include file; sessions
# opened before keep the old key and get refused until reconnected.
cmd_rotate() {
  local what=${1:?usage: clipbridge rotate <alias>|--all}
  local -a files
  if [[ $what == --all ]]; then
    files=("$HOSTS"/*.json(N))
    (( ${#files} )) || { say "no hosts"; return 0; }
  else
    files=("$(host_file "$what")")
    [[ -f ${files[1]} ]] || die "$what isn't set up"
  fi
  (umask 077; python3 -c '
import json, secrets, sys, time
for path in sys.argv[1:]:
    h = json.load(open(path))
    h["token_hex"] = secrets.token_hex(32)
    h["rotated"] = int(time.time())
    json.dump(h, open(path, "w"), indent=2)
' "${files[@]}")
  write_include
  sync_ssh_config 1
  local names=(${files[@]:t:r})
  say "rotated ${(j:, :)names}; reconnect open sessions to use the clipboard"
}

# ---------------------------------------------------------------- pause / status

cmd_pause() { mkdir -p -m 700 "$CONF"; : > "$CONF/paused"; say "paused"; }
cmd_resume() { rm -f "$CONF/paused"; say "resumed"; }

cmd_status() {
  app_running && print "app: running" || print "app: not running"
  [[ -f $CONF/paused ]] && print "state: paused" || print "state: on"
  local f
  for f in "$HOSTS"/*.json(N); do print "host: ${f:t:r} (remote port $(json_get "$f" port))"; done
}

# ---------------------------------------------------------------- doctor

cmd_doctor() {
  local alias=${1:-}
  local fail=0
  ok() { print "  ok    $*"; }
  bad() { print "  FAIL  $*"; fail=1; }
  warn() { print "  warn  $*"; }

  print "mac"
  app_running && ok "ClipBridge running" || bad "ClipBridge not running (clipbridge install)"
  lsof -nP -iTCP:$MAC_PORT -sTCP:LISTEN 2>/dev/null | grep -q "127.0.0.1:$MAC_PORT" && ok "listening on 127.0.0.1:$MAC_PORT only" || bad "nothing on 127.0.0.1:$MAC_PORT"
  [[ -f $CONF/paused ]] && warn "paused (clipbridge resume)"

  [[ -z $alias ]] && { (( fail )) && exit 1 || exit 0; }
  local hf
  hf=$(host_file "$alias")
  [[ -f $hf ]] || die "$alias isn't set up (clipbridge add $alias)"
  local port
  port=$(json_get "$hf" port)

  local mac_kind="" mac_sum=""
  local out
  if out=$("$ROOT/scripts/dev-request.py" --host "$alias" image 2>/dev/null); then
    mac_kind=image; mac_sum=${${(s: :)out}[2]}
  elif out=$("$ROOT/scripts/dev-request.py" --host "$alias" text 2>/dev/null); then
    mac_kind=text; mac_sum=${${(s: :)out}[2]}
  fi
  if [[ -n $mac_kind ]]; then ok "signed local request ($mac_kind)"; else warn "no fresh image or text on the clipboard"; fi

  print "ssh config"
  local g
  g=$(ssh -G "$alias" 2>/dev/null)
  local want
  for want in "remoteforward [127.0.0.1]:$port [127.0.0.1]:$MAC_PORT" "controlmaster auto" "controlpersist 600" "serveraliveinterval 15"; do
    print -r -- "$g" | grep -qxF "$want" && ok "$want" || bad "ssh -G lacks: $want"
  done
  print -r -- "$g" | grep -qE "^controlpath $HOME/\.ssh/cm/[0-9a-f]{40}$" && ok "controlpath ~/.ssh/cm/%C" || bad "controlpath not ~/.ssh/cm/%C"
  # The session key (compared, never printed).
  local key_want key_g
  key_want="v1:$alias:$port:$(json_get "$hf" token_hex)"
  key_g=$(print -r -- "$g" | sed -n 's/^setenv LC_CLIPBRIDGE=//p' | head -1)
  [[ $key_g == "$key_want" ]] && ok "setenv LC_CLIPBRIDGE=<session key>" || bad "ssh -G doesn't send the current session key (setenv LC_CLIPBRIDGE)"
  [[ -f $INCLUDE && $(stat -f %Lp "$INCLUDE") == 600 ]] && ok "~/.config/clipbridge/ssh_config is 0600" || bad "~/.config/clipbridge/ssh_config missing or not 0600"

  print "remote $alias"
  local r
  local key_sum
  key_sum=$(print -rn -- "$key_want" | shasum -a 256 | cut -c1-64)
  r=$("${SSH[@]}" "$alias" 'echo "clock=$(date +%s)"; command -v python3 >/dev/null && echo python3=yes; [ -e ~/.config/clipbridge/config.json ] && echo tokenfile=yes; printf "keysum=%s\n" "$(printf %s "${LC_CLIPBRIDGE:-}" | sha256sum | cut -c1-64)"; ss -ltnp 2>/dev/null | grep -E "127\.0\.0\.1:'"$port"'[[:space:]]" || echo "listener=none"') || bad "ssh $alias failed"
  local rclock
  rclock=$(print -r -- "$r" | sed -n 's/^clock=//p')
  if [[ -n $rclock ]]; then
    local skew=$(( rclock - $(date +%s) ))
    (( ${skew#-} <= 30 )) && ok "clock skew ${skew}s" || bad "clock skew ${skew}s (> 30s; requests will get 401)"
  fi
  [[ $r == *python3=yes* ]] && ok "python3" || bad "no python3"
  [[ $r == *tokenfile=yes* ]] && bad "a key file is on the box (~/.config/clipbridge/config.json); rerun: clipbridge add $alias" || ok "no key stored on the box"
  [[ $(print -r -- "$r" | sed -n 's/^keysum=//p') == "$key_sum" ]] && ok "new sessions carry the session key" || bad "a new session doesn't get the current key (sshd AcceptEnv LC_*?)"
  if [[ $r == *listener=none* ]]; then
    bad "nothing listening on remote 127.0.0.1:$port (open a new ssh session; if one is open from before 'add', run: ssh -O exit $alias)"
  elif print -r -- "$r" | grep -q 'users:(("sshd'; then
    ok "remote 127.0.0.1:$port is our ssh forward"
  elif print -r -- "$r" | grep -q 'users:(('; then
    bad "remote 127.0.0.1:$port is held by another process of yours, not sshd: $(print -r -- "$r" | grep -o 'users:.*')"
  else
    # sshd holds forwards in a process ss can't attribute to you; signed responses guard the rest.
    ok "remote 127.0.0.1:$port listening (owner not visible; responses are signature-checked below)"
  fi

  local rl
  rl=$("${SSH[@]}" -T "$alias" '"$SHELL" -lic "for n in xclip xsel pbpaste; do printf \"which %s %s\n\" \$n \"\$(command -v \$n)\"; done; printf \"claude %s\n\" \"\$(claude --version 2>/dev/null)\"" 2>/dev/null' || true)
  local n got
  for n in xclip xsel pbpaste; do
    got=$(print -r -- "$rl" | sed -n "s/^which $n //p" | tail -1)
    [[ $got == */.local/bin/$n ]] && ok "$n -> $got" || bad "$n resolves to '${got:-nothing}' in a login shell (want ~/.local/bin/$n; re-login or check ~/.zshrc)"
  done
  local cv
  cv=$(print -r -- "$rl" | sed -n 's/^claude //p' | tail -1)
  # Claude Code builds that read the clipboard natively could skip xclip; the harness is the real test.
  [[ -n $cv ]] && ok "claude $cv (after a Claude update, recheck with: scripts/spike/run.sh $alias --real)"

  # Someone else on the same account: a shell without the key must not reach the Mac at all.
  local before after rc_other
  before=$(grep -c "pull host=$alias " "$HOME/Library/Logs/clipbridge.log" 2>/dev/null || true)
  rc_other=$("${SSH[@]}" -T "$alias" "env -u LC_CLIPBRIDGE -u TMUX \"\$SHELL\" -lic 'pbpaste >/dev/null 2>&1; echo rc=\$?' 2>/dev/null" | sed -n 's/^rc=//p' | tail -1)
  sleep 0.5
  after=$(grep -c "pull host=$alias " "$HOME/Library/Logs/clipbridge.log" 2>/dev/null || true)
  if [[ ${before:-0} == "${after:-0}" && $rc_other != 0 ]]; then
    ok "a shell without your session key can't read the clipboard"
  else
    bad "a shell without the session key reached the Mac (pulls ${before:-0}->${after:-0}, rc=$rc_other)"
  fi

  if [[ -n $mac_kind ]]; then
    local cmd
    [[ $mac_kind == image ]] && cmd='xclip -selection clipboard -t image/png -o' || cmd='pbpaste'
    local rs
    rs=$("${SSH[@]}" -T "$alias" "\"\$SHELL\" -lic '$cmd | sha256sum' 2>/dev/null" | grep -oE '^[0-9a-f]{64}' | tail -1 || true)
    [[ $rs == "$mac_sum" ]] && ok "round trip ($mac_kind) sha256 matches" || bad "round trip ($mac_kind): mac $mac_sum, remote ${rs:-none}"
  fi

  (( fail )) && exit 1
  [[ -z $mac_kind ]] && { print "nothing-to-test: copy an image or text and rerun"; exit 3; }
  exit 0
}

# ---------------------------------------------------------------- main

case ${1:-} in
  install) cmd_install ;;
  add) shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  rotate) shift; cmd_rotate "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  pause) cmd_pause ;;
  resume) cmd_resume ;;
  status) cmd_status ;;
  version | --version) print "clipbridge $(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || print dev)" ;;
  *) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
