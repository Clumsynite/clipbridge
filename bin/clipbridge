#!/bin/zsh
# clipbridge: make the Mac clipboard readable from SSH sessions.
#
#   clipbridge install            build ClipBridge.app, start it at login, link this CLI
#   clipbridge add <alias> [--also <ip>]...   set up an ssh host (forward, remote shims, PATH);
#                                 --also: other names/IPs you ssh to for the same box
#   clipbridge new <name> --host <ip> --user <u> [--port N] [--password-stdin] [--install-python]
#                  [--save-to clipbridge|ssh-config]
#                                 add a machine that isn't in ~/.ssh/config (installs a login key);
#                                 ssh-config: keep its Host entry and key as yours after uninstall
#   clipbridge hostkey <host> [--port N]   show a machine's host key fingerprints
#   clipbridge remove <alias>     undo add
#   clipbridge uninstall [-y]     remove everything install and add did (Mac and boxes)
#   clipbridge rotate <alias>|--all   new session keys (open sessions must reconnect)
#   clipbridge doctor [alias]     check everything end to end
#   clipbridge pause | resume     stop / start serving the clipboard
#   clipbridge status             app state, pause state, configured hosts
#   clipbridge version
set -euo pipefail

ROOT=${0:A:h:h}
LABEL=com.clumsyknight.clipbridge
APP=$HOME/Applications/ClipBridge.app
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
CONF=$HOME/.config/clipbridge
HOSTS=$CONF/hosts
SSHCONF=$HOME/.ssh/config
MAC_PORT=7788
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10)
SCP=(scp -q -o BatchMode=yes -o ConnectTimeout=10)

die() { print -u2 "clipbridge: $*"; exit 1; }
say() { print "clipbridge: $*"; }
host_file() { print "$HOSTS/$1.json"; }
json_get() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"; }
# Like json_get, but prints nothing (and succeeds) when the key is missing.
json_opt() { python3 -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2]); print("" if v is None else v)' "$1" "$2"; }

# Machines added with `clipbridge new` log in with this dedicated key, and are trusted through this
# known_hosts file. Both are removed with the last such machine (and by uninstall).
CB_KEY=$HOME/.ssh/clipbridge_ed25519
CB_KNOWN=$HOME/.config/clipbridge/known_hosts

app_running() { pgrep -qx ClipBridge; }

# ---------------------------------------------------------------- install

cmd_install() {
  if [[ -d $ROOT/ClipBridge.app ]]; then
    # Release kit: use the prebuilt app. A downloaded zip is quarantined; this is your own install.
    mkdir -p "${APP:h}"
    rm -rf "$APP"
    ditto "$ROOT/ClipBridge.app" "$APP"
    xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
  else
    # Source checkout: build it (needs Xcode / Swift 6).
    local bundled
    bundled=$("$ROOT/scripts/bundle.sh")
    [[ $bundled == "$APP" ]] || die "bundle step failed"
  fi
  mkdir -p "${PLIST:h}"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$APP/Contents/MacOS/ClipBridge</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  pkill -x ClipBridge 2>/dev/null || true
  sleep 1
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  mkdir -p "$HOME/.local/bin"
  mkdir -p -m 700 "$CONF" "$HOSTS"
  chmod 700 "$CONF" "$HOSTS"
  ln -sf "$ROOT/bin/clipbridge" "$HOME/.local/bin/clipbridge"
  sleep 1
  launchctl print "gui/$(id -u)/$LABEL" | grep -q 'state = running' || die "agent didn't start; see ~/Library/Logs/clipbridge.log"
  say "installed; ClipBridge is running (menu bar)"
}

# ---------------------------------------------------------------- ssh config
#
# ~/.ssh/config gets one marked block that includes ~/.config/clipbridge/ssh_config (0600). That
# file holds a Host block per set-up host, including its session key (SetEnv LC_CLIPBRIDGE=…), so
# the key never sits in the world-readable ~/.ssh/config and never on the remote box's disk.

INCLUDE=$CONF/ssh_config

# The file without any clipbridge block (current single block, or older per-host ones).
strip_ours() {
  awk '/^# clipbridge begin/ { skip = 1; next } /^# clipbridge end/ { skip = 0; next } !skip' "$1"
}

# Pre-existing settings we'd fight with, outside our block.
foreign_settings() {
  awk '
    /^# clipbridge begin/ { skip = 1; next }
    /^# clipbridge end/ { skip = 0; next }
    !skip && tolower($0) ~ /^[ \t]*(controlmaster|controlpath|controlpersist|remoteforward)[ \t=]/ { print NR": "$0 }' "$SSHCONF"
}

# Regenerate the include file from hosts/*.json.
write_include() {
  mkdir -p -m 700 "$CONF"
  python3 - "$HOSTS" "$INCLUDE" "$MAC_PORT" <<'PY'
import glob, json, os, sys
hosts_dir, out, mac_port = sys.argv[1:4]
parts = ["# Generated by clipbridge: holds per-host session keys. Keep it 0600; don't edit by hand.\n"]
home = os.path.expanduser("~")
for path in sorted(glob.glob(os.path.join(hosts_dir, "*.json"))):
    h = json.load(open(path))
    c = h.get("connection")
    if c and c.get("owner", "clipbridge") == "clipbridge":
        # A machine added with `clipbridge new`: how to reach it (only under its own name).
        parts.append(
            "\nHost %s\n  HostName %s\n  User %s\n  Port %d\n"
            "  IdentityFile %s/.ssh/clipbridge_ed25519\n  IdentitiesOnly yes\n"
            "  UserKnownHostsFile %s/.config/clipbridge/known_hosts\n"
            % (h["host"], c["hostname"], c["user"], int(c.get("port", 22)), home, home))
    if not h.get("token_hex") or not h.get("port"):
        continue  # still being set up
    names = []
    for n in [h["host"]] + list(h.get("names_added", {})) + h.get("also", []):
        # Never match loopback: `ssh localhost` must not pick up a forward.
        if n not in names and n not in ("127.0.0.1", "::1", "localhost"):
            names.append(n)
    parts.append(
        "\nHost %s\n"
        "  RemoteForward 127.0.0.1:%d 127.0.0.1:%s\n"
        "  ControlMaster auto\n"
        "  ControlPath ~/.ssh/cm/%%C\n"
        "  ControlPersist 10m\n"
        "  ServerAliveInterval 15\n"
        "  ServerAliveCountMax 3\n"
        "  SetEnv LC_CLIPBRIDGE=v1:%s:%d:%s\n"
        % (" ".join(names), h["port"], mac_port, h["host"], h["port"], h["token_hex"]))
tmp = out + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("".join(parts))
os.chmod(tmp, 0o600)
os.replace(tmp, out)
PY
}

# Make ~/.ssh/config contain exactly our include block (want=1) or none (want=0).
# Backs the file up only when it actually changes.
sync_ssh_config() {
  local want=$1 tmp
  tmp=$(mktemp)
  strip_ours "$SSHCONF" > "$tmp"
  if (( want )); then
    [[ -s $tmp && -n $(tail -c1 "$tmp") ]] && print >> "$tmp"
    print -r -- '# clipbridge begin' >> "$tmp"
    print -r -- 'Match all' >> "$tmp"
    print -r -- 'Include ~/.config/clipbridge/ssh_config' >> "$tmp"
    print -r -- '# clipbridge end' >> "$tmp"
  fi
  if ! cmp -s "$tmp" "$SSHCONF"; then
    cp -p "$SSHCONF" "$SSHCONF.bak-clipbridge-$(date +%Y%m%d-%H%M%S)"
    cat "$tmp" > "$SSHCONF"
  fi
  rm -f "$tmp"
}

# A shared ssh connection (ControlMaster) hands every new session the key and forwards it was opened
# with. After a key or forward change, tell it to stop taking new sessions: the ones already open on
# it keep running, and the next session opens a fresh connection with the current settings.
retire_master() {
  "${SSH[@]}" -O stop "$1" >/dev/null 2>&1 || true
}

hosts_count() { local -a f; f=("$HOSTS"/*.json(N)); print ${#f}; }

# ---------------------------------------------------------------- remote rc block

rc_file_for() {
  case ${1:t} in
    zsh) print .zshrc ;;
    bash) print .bashrc ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------- add

cmd_add() {
  local alias=${1:?usage: clipbridge add <alias> [--also <host-or-ip>]...}
  shift
  local -a also=()
  while (( $# )); do
    case $1 in
      --also) [[ -n ${2:-} ]] || die "--also needs a host or IP"; also+=("$2"); shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  local n
  for n in $also; do [[ $n =~ '^[A-Za-z0-9._:-]+$' ]] || die "bad --also name: $n"; done
  [[ $alias =~ '^[A-Za-z0-9._-]+$' ]] || die "alias must be letters, digits, . _ -"
  [[ -f $SSHCONF ]] || die "no $SSHCONF"
  local foreign
  foreign=$(foreign_settings)
  [[ -z $foreign ]] || die "ssh config already sets ControlMaster/ControlPath/ControlPersist/RemoteForward; resolve first:
$foreign"

  say "checking $alias"
  local info
  info=$("${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$alias" 'printf "shell=%s\n" "$SHELL"; command -v python3 >/dev/null && echo python3=yes; for n in clipbridge-shim xclip xsel pbpaste; do f="$HOME/.local/bin/$n"; if [ -L "$f" ]; then echo "link $n $(readlink "$f")"; elif [ -e "$f" ]; then echo "file $n"; fi; done; ss -ltn 2>/dev/null | awk "NR>1{print \"port \" \$4}"; for a in $(hostname -I 2>/dev/null); do case $a in *:*) ;; *) echo "ip $a" ;; esac; done') \
    || die "can't reach $alias non-interactively (needs key auth)"
  [[ $info == *python3=yes* ]] || { print -u2 "needs-python3"; die "$alias has no python3 (clipbridge's shim needs it). Install it, or set the box up with: clipbridge new … --install-python"; }
  local rshell rc
  rshell=$(print -r -- "$info" | sed -n 's/^shell=//p')
  rc=$(rc_file_for "$rshell") || die "remote shell $rshell not supported (zsh or bash)"
  local conflicts
  conflicts=$(print -r -- "$info" | awk '$1=="file" && $2!="clipbridge-shim" {print $2} $1=="link" && $3!="clipbridge-shim" {print $2}')
  [[ -z $conflicts ]] || die "$alias already has these in ~/.local/bin (not ours): ${(f)conflicts}"

  mkdir -p -m 700 "$HOSTS"
  local hf port token
  hf=$(host_file "$alias")
  local names=""
  if [[ -f $hf && -n $(json_opt "$hf" token_hex) ]]; then
    port=$(json_get "$hf" port)
    token=$(json_get "$hf" token_hex)
    names=$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1])).get("also", [])))' "$hf")
  else
    local used
    used=$(print -r -- "$info" | sed -n 's/^port .*:\([0-9]*\)$/\1/p')
    for _ in {1..50}; do
      port=$(( 20000 + RANDOM % 12768 ))
      print -r -- "$used" | grep -qx "$port" || break
    done
    token=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
  fi

  local backup=$SSHCONF.bak-clipbridge-$(date +%Y%m%d-%H%M%S)
  cp -p "$SSHCONF" "$backup"
  local created_host=0 hf_backup=""
  if [[ -f $hf ]]; then hf_backup=$(mktemp); cp -p "$hf" "$hf_backup"; else created_host=1; fi
  rollback() {
    say "failed; restoring $SSHCONF from $backup"
    cp -p "$backup" "$SSHCONF"
    if (( created_host )); then rm -f "$hf"; elif [[ -n $hf_backup ]]; then cp -p "$hf_backup" "$hf"; fi
    write_include 2>/dev/null || true
  }
  trap 'rollback' ZERR
  trap - ERR

  for n in $also; do [[ " $names " == *" $n "* ]] || names+=" $n"; done
  names=${names# }
  local ips hn
  ips=$(print -r -- "$info" | sed -n 's/^ip //p' | tr '\n' ' ')
  hn=$(ssh -G "$alias" 2>/dev/null | awk '$1 == "hostname" { print $2 }')
  # Host JSON (Mac only, 0600). Besides the token: which names the ssh block matches and since
  # when (names_added), and the box's own IPv4 addresses (ips), so the app can spot an ssh
  # session that reached this box by a name the block doesn't match.
  (umask 077; python3 - "$hf" "$alias" "$port" "$token" "$names" "$ips" "$hn" <<'PY'
import json, os, sys, time
hf, alias, port, token, also, ips, hn = sys.argv[1:8]
old = {}
if os.path.exists(hf):
    try:
        old = json.load(open(hf))
    except ValueError:
        pass
now = int(time.time())
matched = [alias] + ([hn] if hn and hn != alias else []) + also.split()
names_added = {n: t for n, t in old.get("names_added", {}).items() if n in matched}
for n in matched:
    names_added.setdefault(n, now)
# Keep fields this step doesn't manage (connection, installed_python3, …).
out = dict(old)
out.update({
    "host": alias, "port": int(port), "token_hex": token,
    "also": also.split(), "ips": ips.split(),
    "added": old.get("added", now), "names_added": names_added,
    "rotated": old.get("rotated", now),
})
json.dump(out, open(hf, "w"), indent=2)
PY
  )
  write_include
  sync_ssh_config 1
  mkdir -p -m 700 "$HOME/.ssh/cm"
  retire_master "$alias"

  "${SSH[@]}" "$alias" 'mkdir -p ~/.local/bin'
  "${SCP[@]}" "$ROOT/remote/clipbridge-shim" "$ROOT/remote/clipbridge-attach" "$alias:.local/bin/"
  # Key on disk from older versions: remove it. The key now only travels in your sessions' env.
  "${SSH[@]}" "$alias" 'cd ~/.local/bin && chmod 755 clipbridge-shim clipbridge-attach && for n in xclip xsel pbpaste; do ln -sfn clipbridge-shim "$n"; done; rm -f ~/.config/clipbridge/config.json; rmdir ~/.config/clipbridge 2>/dev/null; true'
  # PATH block in the shell rc: replace ours in place. The exact inverse of REMOTE_CLEANUP, which
  # removes "\n# clipbridge begin … end\n", so repeated adds and a final uninstall leave no trace.
  "${SSH[@]}" -T "$alias" "python3 - ~/$rc" <<'PY'
import re, sys
p = sys.argv[1]
try:
    s = open(p).read()
except FileNotFoundError:
    s = ""
s = re.sub(r"\n?# clipbridge begin\n.*?# clipbridge end\n", "", s, flags=re.S)
if s and not s.endswith("\n"):
    s += "\n"
s += '\n# clipbridge begin\nexport PATH="$HOME/.local/bin:$PATH"\n# clipbridge end\n'
open(p, "w").write(s)
PY

  trap - ZERR
  [[ -n $hf_backup ]] && rm -f "$hf_backup"
  local others="" a
  for a in ${=ips}; do [[ " $alias $hn $names " == *" $a "* ]] || others+=" $a"; done
  say "added $alias (remote port $port). Open a new ssh session, then run: clipbridge doctor $alias"
  [[ -n $others ]] && print "other-ips:$others" && say "if you also ssh to it as${others}, run: clipbridge add $alias --also <ip>"
  return 0
}

# ---------------------------------------------------------------- new machines

# Host key fingerprints of a machine, for you to compare before trusting it.
#   clipbridge hostkey <host> [--port N]
cmd_hostkey() {
  local host=${1:?usage: clipbridge hostkey <host> [--port N]} port=22
  shift
  [[ ${1:-} == --port ]] && port=${2:?--port needs a number}
  local keys
  keys=$(ssh-keyscan -T 8 -p "$port" "$host" 2>/dev/null) || true
  [[ -n $keys ]] || die "no ssh host keys from $host:$port (is sshd running and reachable?)"
  print -r -- "$keys" | ssh-keygen -lf - | awk '{print $2, $NF}'
}

# Add a machine that isn't in ~/.ssh/config: trust its host key, install a dedicated key with your
# password (once, via ssh-copy-id), optionally install python3, then set it up like `add`.
#   clipbridge new <name> --host <host-or-ip> --user <user> [--port N] [--also <ip>]...
#                  [--accept-hostkey SHA256:…] [--password-stdin] [--install-python]
# Exit codes: 0 ok, 1 error, 4 needs python3 (rerun with --install-python).
cmd_new() {
  local name=${1:?usage: clipbridge new <name> --host <host> --user <user> [--port N] [...]}
  shift
  local host="" user="" port=22 accept="" pwstdin=0 install_py=0 save_to=clipbridge
  local -a also=()
  while (( $# )); do
    case $1 in
      --host) host=${2:?}; shift 2 ;;
      --user) user=${2:?}; shift 2 ;;
      --port) port=${2:?}; shift 2 ;;
      --also) also+=("${2:?}"); shift 2 ;;
      --accept-hostkey) accept=${2:?}; shift 2 ;;
      --password-stdin) pwstdin=1; shift ;;
      --install-python) install_py=1; shift ;;
      --save-to) save_to=${2:?}; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ $name =~ '^[A-Za-z0-9._-]+$' ]] || die "name must be letters, digits, . _ -"
  [[ -n $host && $host =~ '^[A-Za-z0-9._:-]+$' ]] || die "--host is required (a hostname or IP)"
  [[ -n $user && $user =~ '^[A-Za-z0-9._-]+$' ]] || die "--user is required"
  [[ $port =~ '^[0-9]+$' ]] || die "--port must be a number"
  [[ $save_to == clipbridge || $save_to == ssh-config ]] || die "--save-to is clipbridge or ssh-config"
  # A host file without a key is a setup that stopped half-way (e.g. at "needs python3"): continue it.
  [[ -f $(host_file "$name") && -n $(json_opt "$(host_file "$name")" token_hex) ]] && die "$name is already set up"
  local existing
  existing=$(SSHConfig_names)
  if [[ " $existing " == *" $name "* ]] && ! user_host_is_ours "$name"; then
    die "$name is already a Host in ~/.ssh/config; use: clipbridge add $name"
  fi

  # Where the connection lives decides which key and known_hosts it uses:
  #   clipbridge  → clipbridge's include, the shared clipbridge key, clipbridge's known_hosts;
  #                 remove/uninstall take all of it back (including the key on the box).
  #   ssh-config  → a normal Host block in your ~/.ssh/config, its own ~/.ssh/id_ed25519_<name>,
  #                 your ~/.ssh/known_hosts; yours to keep: remove/uninstall leave it alone.
  local key known
  if [[ $save_to == ssh-config ]]; then
    key=$HOME/.ssh/id_ed25519_$name
    known=$HOME/.ssh/known_hosts
  else
    key=$CB_KEY
    known=$CB_KNOWN
  fi

  local password=""
  if (( pwstdin )); then IFS= read -r password || true; fi

  # 1. Host key: show it, and trust only what you confirmed.
  mkdir -p -m 700 "$CONF" "$HOSTS"
  local keys fps
  keys=$(ssh-keyscan -T 8 -p "$port" "$host" 2>/dev/null) || true
  [[ -n $keys ]] || die "no ssh host keys from $host:$port (is sshd running and reachable?)"
  fps=$(print -r -- "$keys" | ssh-keygen -lf - | awk '{print $2}')
  if [[ -z $accept ]]; then
    print "Host key fingerprints for $host:$port:"
    print -r -- "$keys" | ssh-keygen -lf - | awk '{print "  " $2, $NF}'
    [[ -t 0 ]] || die "not a terminal; pass --accept-hostkey <SHA256:…> after checking the fingerprint"
    local reply
    read -r "reply?Trust this host? [y/N] "
    [[ $reply == [yY]* ]] || die "not trusted; nothing changed"
  else
    print -r -- "$fps" | grep -qxF -- "$accept" || die "host key doesn't match $accept; not trusting it"
  fi
  # known_hosts lines are keyed by how ssh names the host: [host]:port when the port isn't 22.
  local known_name=$host
  [[ $port == 22 ]] || known_name="[$host]:$port"
  touch "$known"; chmod 600 "$known"
  # Add only lines that aren't there yet (your own known_hosts is never reordered).
  local line
  print -r -- "$keys" | awk -v n="$known_name" '{ $1 = n; print }' | while IFS= read -r line; do
    grep -qxF -- "$line" "$known" || print -r -- "$line" >> "$known"
  done

  # 2. The login key, made once.
  if [[ ! -f $key ]]; then
    local comment="clipbridge@$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
    [[ $save_to == ssh-config ]] && comment="$name@$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
    ssh-keygen -q -t ed25519 -N "" -C "$comment" -f "$key"
  fi

  # 3. The host file (connection only, no forward yet) so `ssh <name>` works from here on.
  local hf
  hf=$(host_file "$name")
  local owner=clipbridge
  [[ $save_to == ssh-config ]] && owner=user
  (umask 077; python3 -c '
import json, sys, time
hf, name, host, user, port, owner = sys.argv[1:7]
json.dump({"host": name, "connection": {"hostname": host, "user": user, "port": int(port), "owner": owner},
           "added": int(time.time())}, open(hf, "w"), indent=2)
' "$hf" "$name" "$host" "$user" "$port" "$owner")
  local added_user_host=0
  if [[ $owner == user ]] && ! user_host_is_ours "$name"; then
    write_user_host "$name" "$host" "$user" "$port" "$key"
    added_user_host=1
  fi
  write_include
  sync_ssh_config 1
  local cleanup_new=1
  new_rollback() {
    (( cleanup_new )) || return 0
    rm -f "$hf"
    (( added_user_host )) && remove_user_host "$name"
    write_include
    (( $(hosts_count) )) || { sync_ssh_config 0; rm -f "$INCLUDE"; }
  }
  trap 'new_rollback' EXIT

  # 4. Log in with the key; if that doesn't work yet, install it with the password (ssh-copy-id).
  if ! "${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$name" true 2>/dev/null; then
    [[ -n $password ]] || die "the key isn't on $name yet; give the password with --password-stdin"
    with_askpass "$password" ssh-copy-id -f -i "$key.pub" -o ControlPath=none -o ClearAllForwardings=yes \
      -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no "$name" >/dev/null 2>&1 \
      || die "ssh-copy-id failed (wrong password, or password login disabled on $name)"
    "${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$name" true 2>/dev/null \
      || die "the key was copied but logging in with it still fails"
  fi
  say "logged in to $name with ${key/#$HOME/~}"

  # 5. python3 for the shim.
  if ! "${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$name" 'command -v python3 >/dev/null' 2>/dev/null; then
    if (( ! install_py )); then
      print -u2 "needs-python3"
      say "$name has no python3; rerun with --install-python to install it (uses sudo)"
      cleanup_new=0  # keep the trusted connection; the rerun continues from here
      trap - EXIT
      return 4
    fi
    say "installing python3 on $name (sudo)"
    local pm_cmd='if command -v apt-get >/dev/null; then export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get install -y -qq python3-minimal; elif command -v dnf >/dev/null; then dnf install -y -q python3; elif command -v yum >/dev/null; then yum install -y -q python3; elif command -v apk >/dev/null; then apk add -q python3; elif command -v zypper >/dev/null; then zypper -q -n install python3; elif command -v pacman >/dev/null; then pacman -S --noconfirm --needed python; else echo "no known package manager" >&2; exit 3; fi'
    # The password goes to sudo on stdin (-S), never on a command line.
    print -r -- "$password" | "${SSH[@]}" -T -o ControlPath=none -o ClearAllForwardings=yes "$name" \
      "sudo -S -p '' sh -c ${(q)pm_cmd}" >/dev/null 2>&1 \
      || die "installing python3 failed (needs sudo; check the password or install it yourself)"
    "${SSH[@]}" -o ControlPath=none -o ClearAllForwardings=yes "$name" 'command -v python3 >/dev/null' \
      || die "python3 still missing after install"
    python3 -c 'import json,sys; p=sys.argv[1]; h=json.load(open(p)); h["installed_python3"]=True; json.dump(h,open(p,"w"),indent=2)' "$hf"
  fi

  # 6. The usual setup.
  cleanup_new=0
  trap - EXIT
  cmd_add "$name" ${also:+--also} ${also[@]}
}

# Run a command with ssh's password prompt answered from memory: a one-time askpass helper reads it
# from a FIFO in a private temp dir. The password never touches the disk or a command line.
with_askpass() {
  local password=$1; shift
  local dir fifo helper writer rc
  dir=$(mktemp -d)
  chmod 700 "$dir"
  fifo=$dir/pw
  helper=$dir/askpass
  mkfifo -m 600 "$fifo"
  print -r -- "#!/bin/sh
exec cat ${(q)fifo}" > "$helper"
  chmod 700 "$helper"
  ( for _ in 1 2 3; do print -r -- "$password" > "$fifo" || break; done ) &
  writer=$!
  SSH_ASKPASS=$helper SSH_ASKPASS_REQUIRE=force DISPLAY=${DISPLAY:-:0} "$@" < /dev/null
  rc=$?
  kill $writer 2>/dev/null
  wait $writer 2>/dev/null
  rm -rf "$dir"
  return $rc
}

# A Host block for a `--save-to ssh-config` machine, written into your ~/.ssh/config just above
# clipbridge's block. Marked with a comment so a failed setup can take it back; afterwards it's yours.
USER_HOST_MARK="# Added by clipbridge new:"
write_user_host() {
  local name=$1 host=$2 user=$3 port=$4 key=$5 tmp
  cp -p "$SSHCONF" "$SSHCONF.bak-clipbridge-$(date +%Y%m%d-%H%M%S)"
  tmp=$(mktemp)
  python3 - "$SSHCONF" "$tmp" "$USER_HOST_MARK $name ($(date +%Y-%m-%d)). It's yours: clipbridge remove/uninstall leave it." \
    "$name" "$host" "$user" "$port" "${key/#$HOME/~}" <<'PY'
import sys
src, out, mark, name, host, user, port, key = sys.argv[1:9]
s = open(src).read()
block = (f"{mark}\nHost {name}\n  HostName {host}\n  User {user}\n  Port {port}\n"
         f"  IdentityFile {key}\n  IdentitiesOnly yes\n\n")
i = s.find("# clipbridge begin")
head, tail = (s, "") if i == -1 else (s[:i], s[i:])
if head and not head.endswith("\n"):
    head += "\n"
if head and not head.endswith("\n\n"):
    head += "\n"  # a blank line between your last block and this one
s = head + block + tail
open(out, "w").write(s)
PY
  cat "$tmp" > "$SSHCONF"
  rm -f "$tmp"
}

user_host_is_ours() { grep -qF "$USER_HOST_MARK $1 (" "$SSHCONF" 2>/dev/null; }

remove_user_host() {
  local name=$1 tmp
  tmp=$(mktemp)
  python3 - "$SSHCONF" "$tmp" "$USER_HOST_MARK $name (" <<'PY'
import re, sys
src, out, mark = sys.argv[1:4]
s = open(src).read()
s = re.sub(r"(?m)^" + re.escape(mark) + r".*\n(?:(?!\n).*\n)*?\n", "", s, count=1)
open(out, "w").write(s)
PY
  cat "$tmp" > "$SSHCONF"
  rm -f "$tmp"
}

# Host aliases already in ~/.ssh/config (outside clipbridge's block).
SSHConfig_names() {
  strip_ours "$SSHCONF" 2>/dev/null | awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' | tr '\n' ' '
}

# ---------------------------------------------------------------- remove

# Everything clipbridge (or its test harness) ever puts on a box, removed. Runs on the box via sh -s.
# Prints "left: …" for anything it couldn't remove, and "clean" when nothing is left.
REMOTE_CLEANUP=$(cat <<'REMOTE'
cd "$HOME" || exit 1
b=$HOME/.local/bin
for n in xclip xsel pbpaste; do
  [ -L "$b/$n" ] && [ "$(readlink "$b/$n")" = clipbridge-shim ] && rm -f "$b/$n"
done
rm -f "$b/clipbridge-shim" "$b/clipbridge-attach"
rm -rf "$HOME/.config/clipbridge" "$HOME/.cache/cb-spike"
# The PATH block (and the blank line add put before it) in shell rc files.
for f in "$HOME/.zshrc" "$HOME/.bashrc"; do
  [ -f "$f" ] || continue
  python3 - "$f" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p).read()
t = re.sub(r"\n?# clipbridge begin\n.*?# clipbridge end\n", "", s, flags=re.S)
if t != s:
    open(p, "w").write(t)
PY
done
# tmux: undo what clipbridge-attach set on sessions (their own update-environment list, and the key).
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux list-sessions -F '#{session_name}' | while read -r s; do
    if tmux show-options -t "$s" update-environment 2>/dev/null | grep -q LC_CLIPBRIDGE; then
      tmux set-option -t "$s" -u update-environment
    fi
    tmux set-environment -t "$s" -u LC_CLIPBRIDGE 2>/dev/null
  done
fi
# The trust entry the paste test left in Claude Code's config (only that exact folder).
if [ -f "$HOME/.claude.json" ]; then
  python3 - "$HOME/.claude.json" "$HOME/.cache/cb-spike/ws" <<'PY'
import json, os, sys
p, ws = sys.argv[1:3]
try:
    d = json.load(open(p))
except ValueError:
    sys.exit(0)
if ws in d.get("projects", {}):
    del d["projects"][ws]
    tmp = p + ".cb-tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.chmod(tmp, os.stat(p).st_mode & 0o777)
    os.replace(tmp, p)
PY
fi
# Verify.
left=""
for x in "$b/clipbridge-shim" "$b/clipbridge-attach" "$HOME/.config/clipbridge" "$HOME/.cache/cb-spike"; do
  [ -e "$x" ] && left="$left $x"
done
for n in xclip xsel pbpaste; do
  [ -L "$b/$n" ] && [ "$(readlink "$b/$n")" = clipbridge-shim ] && left="$left $b/$n"
done
for f in "$HOME/.zshrc" "$HOME/.bashrc"; do
  [ -f "$f" ] && grep -q '^# clipbridge begin' "$f" && left="$left $f(block)"
done
grep -q 'cb-spike/ws' "$HOME/.claude.json" 2>/dev/null && left="$left ~/.claude.json(trust entry)"
# The dedicated login key of a machine added with `clipbridge new` (passed as $1). Last on purpose.
if [ -n "${1:-}" ] && [ -f "$HOME/.ssh/authorized_keys" ]; then
  if grep -qxF -- "$1" "$HOME/.ssh/authorized_keys"; then
    grep -vxF -- "$1" "$HOME/.ssh/authorized_keys" > "$HOME/.ssh/authorized_keys.cb-tmp"
    cat "$HOME/.ssh/authorized_keys.cb-tmp" > "$HOME/.ssh/authorized_keys"
    rm -f "$HOME/.ssh/authorized_keys.cb-tmp"
  fi
  grep -qxF -- "$1" "$HOME/.ssh/authorized_keys" && left="$left ~/.ssh/authorized_keys(clipbridge key)"
  # ssh-copy-id may have created these for us; drop them only if nothing else is in them.
  [ -s "$HOME/.ssh/authorized_keys" ] || rm -f "$HOME/.ssh/authorized_keys"
  rmdir "$HOME/.ssh" 2>/dev/null
fi
rmdir "$HOME/.local/bin" 2>/dev/null && rmdir "$HOME/.local" 2>/dev/null
if [ -n "$left" ]; then echo "left:$left"; else echo clean; fi
REMOTE
)

# Remove a host on the remote side. Returns non-zero if the box couldn't be reached or cleaned.
remote_cleanup() {
  local alias=$1 port=${2:-} pub=${3:-} out
  if [[ -n $port ]]; then
    # Stop forwarding on any live shared connection without closing your open sessions.
    "${SSH[@]}" -O cancel -R "127.0.0.1:$port:127.0.0.1:$MAC_PORT" "$alias" 2>/dev/null || true
  fi
  out=$(print -r -- "$REMOTE_CLEANUP" | "${SSH[@]}" -T -o ControlPath=none -o ClearAllForwardings=yes "$alias" "sh -s -- ${(q)pub}" 2>&1) || {
    say "warning: couldn't reach $alias to clean it up: ${out##*$'\n'}"
    return 1
  }
  if [[ $out == *clean* ]]; then
    say "$alias: nothing of clipbridge left on the box"
  else
    say "warning: $alias: ${(M)${(f)out}:#left:*}"
    return 1
  fi
}

cmd_remove() {
  local alias=${1:?usage: clipbridge remove <alias>}
  local hf port="" rc=0
  hf=$(host_file "$alias")
  local pub="" py_note=""
  [[ -f $hf ]] && port=$(json_opt "$hf" port)
  [[ -f $hf && -n $(json_opt "$hf" installed_python3) ]] && py_note=1
  if [[ -f $hf && -f $CB_KEY.pub ]] && python3 -c 'import json,sys; c=json.load(open(sys.argv[1])).get("connection"); sys.exit(0 if c and c.get("owner","clipbridge")=="clipbridge" else 1)' "$hf"; then
    pub=$(<"$CB_KEY.pub")
  fi
  remote_cleanup "$alias" "$port" "$pub" || rc=1
  rm -f "$hf"
  if (( $(hosts_count) )); then
    write_include
    sync_ssh_config 1
  else
    sync_ssh_config 0
    rm -f "$INCLUDE"
  fi
  # The dedicated key and its known_hosts go with the last machine that used them.
  if ! python3 -c 'import glob,json,sys,os; sys.exit(0 if any((json.load(open(f)).get("connection") or {}).get("owner","clipbridge")=="clipbridge" and json.load(open(f)).get("connection") for f in glob.glob(os.path.join(sys.argv[1],"*.json"))) else 1)' "$HOSTS"; then
    rm -f "$CB_KEY" "$CB_KEY.pub" "$CB_KNOWN"
  fi
  say "removed $alias"
  [[ -n $py_note ]] && say "note: clipbridge installed python3 on $alias; it's a system package other software may now use, so it was left in place (remove it with the box's package manager if you want)"
  return $rc
}

# ---------------------------------------------------------------- uninstall

# Undo everything install and add did, on the Mac and on every set-up box.
#   clipbridge uninstall [-y] [--keep-backups]
cmd_uninstall() {
  local yes=0 keep_backups=0 a
  for a in "$@"; do
    case $a in
      -y | --yes) yes=1 ;;
      --keep-backups) keep_backups=1 ;;
      *) die "usage: clipbridge uninstall [-y] [--keep-backups]" ;;
    esac
  done
  local -a hosts
  hosts=("$HOSTS"/*.json(N:t:r))
  print "This removes ClipBridge from this Mac${hosts:+ and from: ${(j:, :)hosts}}:"
  print "  mac:  $APP, the login item, ~/.local/bin/clipbridge, ~/.config/clipbridge (keys),"
  print "        the clipbridge block in ~/.ssh/config, ~/.ssh/cm (if empty), the log, app preferences"
  (( keep_backups )) || print "        and the ~/.ssh/config.bak-clipbridge-* backups"
  (( ${#hosts} )) && print "  boxes: the shims, clipbridge-attach, the PATH block, tmux settings it made, test leftovers"
  if (( ! yes )); then
    [[ -t 0 ]] || die "not a terminal; rerun with -y to confirm"
    local reply
    read -r "reply?Continue? [y/N] "
    [[ $reply == [yY]* ]] || { say "nothing removed"; return 1; }
  fi

  local rc=0 h
  for h in $hosts; do cmd_remove "$h" || rc=1; done

  # The app and its login item.
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  pkill -x ClipBridge 2>/dev/null || true
  rm -f "$PLIST"
  if [[ -d $APP ]]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$APP" 2>/dev/null || true
    rm -rf "$APP"
  fi
  # Privacy permissions macOS recorded for it (paste access, notifications); harmless if none.
  tccutil reset All com.clumsyknight.clipbridge >/dev/null 2>&1 || true
  defaults delete com.clumsyknight.clipbridge >/dev/null 2>&1 || true
  rm -f "$HOME/Library/Preferences/com.clumsyknight.clipbridge.plist"
  rm -f "$HOME/Library/Logs/clipbridge.log"
  # The CLI link, only if it's ours.
  local link=$HOME/.local/bin/clipbridge
  [[ -L $link && $(readlink "$link") == */bin/clipbridge ]] && rm -f "$link"

  # ssh config: our block, keys, the shared-connection socket folder.
  [[ -f $SSHCONF ]] && sync_ssh_config 0
  rm -rf "$CONF"
  rm -f "$CB_KEY" "$CB_KEY.pub"
  rmdir "$HOME/.ssh/cm" 2>/dev/null || [[ ! -d $HOME/.ssh/cm ]] \
    || say "kept ~/.ssh/cm: an ssh connection is still open (it goes away within 10 minutes of your last session)"
  (( keep_backups )) || rm -f "$SSHCONF".bak-clipbridge-*(N)

  # Verify.
  local -a left
  for a in "$APP" "$PLIST" "$CONF" "$link" "$HOME/Library/Logs/clipbridge.log" "$CB_KEY" "$CB_KEY.pub"; do
    [[ -e $a || -L $a ]] && left+=("$a")
  done
  [[ -f $SSHCONF ]] && grep -q '^# clipbridge begin' "$SSHCONF" && left+=("$SSHCONF (block)")
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 && left+=("login item $LABEL")
  pgrep -qx ClipBridge && left+=("running ClipBridge process")
  if (( ${#left} )); then
    say "left behind on this Mac: ${(j:, :)left}"
    rc=1
  else
    say "uninstalled from this Mac"
  fi
  if [[ -d $ROOT/ClipBridge.app ]]; then
    say "the release folder you installed from is still at $ROOT; delete it if you don't need it"
  fi
  return $rc
}

# ---------------------------------------------------------------- rotate

# New session keys. Mac-only: new ssh sessions pick the key up from the include file; sessions
# opened before keep the old key and get refused until reconnected.
cmd_rotate() {
  local what=${1:?usage: clipbridge rotate <alias>|--all}
  local -a files
  if [[ $what == --all ]]; then
    files=("$HOSTS"/*.json(N))
    (( ${#files} )) || { say "no hosts"; return 0; }
  else
    files=("$(host_file "$what")")
    [[ -f ${files[1]} ]] || die "$what isn't set up"
  fi
  (umask 077; python3 -c '
import json, secrets, sys, time
for path in sys.argv[1:]:
    h = json.load(open(path))
    h["token_hex"] = secrets.token_hex(32)
    h["rotated"] = int(time.time())
    json.dump(h, open(path, "w"), indent=2)
' "${files[@]}")
  write_include
  sync_ssh_config 1
  local names=(${files[@]:t:r}) n
  for n in $names; do retire_master "$n"; done
  say "rotated ${(j:, :)names}; reconnect open sessions to use the clipboard"
}

# ---------------------------------------------------------------- pause / status

cmd_pause() { mkdir -p -m 700 "$CONF"; : > "$CONF/paused"; say "paused"; }
cmd_resume() { rm -f "$CONF/paused"; say "resumed"; }

cmd_status() {
  app_running && print "app: running" || print "app: not running"
  [[ -f $CONF/paused ]] && print "state: paused" || print "state: on"
  local f
  for f in "$HOSTS"/*.json(N); do print "host: ${f:t:r} (remote port $(json_get "$f" port))"; done
}

# ---------------------------------------------------------------- doctor

cmd_doctor() {
  local alias=${1:-}
  local fail=0
  ok() { print "  ok    $*"; }
  bad() { print "  FAIL  $*"; fail=1; }
  warn() { print "  warn  $*"; }

  print "mac"
  app_running && ok "ClipBridge running" || bad "ClipBridge not running (clipbridge install)"
  lsof -nP -iTCP:$MAC_PORT -sTCP:LISTEN 2>/dev/null | grep -q "127.0.0.1:$MAC_PORT" && ok "listening on 127.0.0.1:$MAC_PORT only" || bad "nothing on 127.0.0.1:$MAC_PORT"
  [[ -f $CONF/paused ]] && warn "paused (clipbridge resume)"

  [[ -z $alias ]] && { (( fail )) && exit 1 || exit 0; }
  local hf
  hf=$(host_file "$alias")
  [[ -f $hf ]] || die "$alias isn't set up (clipbridge add $alias)"
  local port
  port=$(json_get "$hf" port)

  local mac_kind="" mac_sum=""
  local out
  if out=$("$ROOT/scripts/dev-request.py" --host "$alias" image 2>/dev/null); then
    mac_kind=image; mac_sum=${${(s: :)out}[2]}
  elif out=$("$ROOT/scripts/dev-request.py" --host "$alias" text 2>/dev/null); then
    mac_kind=text; mac_sum=${${(s: :)out}[2]}
  fi
  if [[ -n $mac_kind ]]; then ok "signed local request ($mac_kind)"; else warn "no fresh image or text on the clipboard"; fi

  print "ssh config"
  local g
  g=$(ssh -G "$alias" 2>/dev/null)
  local want
  for want in "remoteforward [127.0.0.1]:$port [127.0.0.1]:$MAC_PORT" "controlmaster auto" "controlpersist 600" "serveraliveinterval 15"; do
    print -r -- "$g" | grep -qxF "$want" && ok "$want" || bad "ssh -G lacks: $want"
  done
  print -r -- "$g" | grep -qE "^controlpath $HOME/\.ssh/cm/[0-9a-f]{40}$" && ok "controlpath ~/.ssh/cm/%C" || bad "controlpath not ~/.ssh/cm/%C"
  # The session key (compared, never printed).
  local key_want key_g
  key_want="v1:$alias:$port:$(json_get "$hf" token_hex)"
  key_g=$(print -r -- "$g" | sed -n 's/^setenv LC_CLIPBRIDGE=//p' | head -1)
  [[ $key_g == "$key_want" ]] && ok "setenv LC_CLIPBRIDGE=<session key>" || bad "ssh -G doesn't send the current session key (setenv LC_CLIPBRIDGE)"
  [[ -f $INCLUDE && $(stat -f %Lp "$INCLUDE") == 600 ]] && ok "~/.config/clipbridge/ssh_config is 0600" || bad "~/.config/clipbridge/ssh_config missing or not 0600"

  print "remote $alias"
  local r
  local key_sum
  key_sum=$(print -rn -- "$key_want" | shasum -a 256 | cut -c1-64)
  r=$("${SSH[@]}" "$alias" 'echo "clock=$(date +%s)"; command -v python3 >/dev/null && echo python3=yes; [ -e ~/.config/clipbridge/config.json ] && echo tokenfile=yes; printf "keysum=%s\n" "$(printf %s "${LC_CLIPBRIDGE:-}" | sha256sum | cut -c1-64)"; if command -v ss >/dev/null; then ss -ltnp 2>/dev/null | grep -E "127\.0\.0\.1:'"$port"'[[:space:]]" || echo "listener=none"; else python3 -c "import socket,sys; s=socket.socket(); s.settimeout(2); sys.exit(s.connect_ex((\"127.0.0.1\", '"$port"')))" && echo "listener=up" || echo "listener=none"; fi') || bad "ssh $alias failed"
  local rclock
  rclock=$(print -r -- "$r" | sed -n 's/^clock=//p')
  if [[ -n $rclock ]]; then
    local skew=$(( rclock - $(date +%s) ))
    (( ${skew#-} <= 30 )) && ok "clock skew ${skew}s" || bad "clock skew ${skew}s (> 30s; requests will get 401)"
  fi
  [[ $r == *python3=yes* ]] && ok "python3" || bad "no python3"
  [[ $r == *tokenfile=yes* ]] && bad "a key file is on the box (~/.config/clipbridge/config.json); rerun: clipbridge add $alias" || ok "no key stored on the box"
  [[ $(print -r -- "$r" | sed -n 's/^keysum=//p') == "$key_sum" ]] && ok "new sessions carry the session key" || bad "a new session doesn't get the current key (sshd AcceptEnv LC_*?)"
  if [[ $r == *listener=none* ]]; then
    bad "nothing listening on remote 127.0.0.1:$port (open a new ssh session; if one is open from before 'add', run: ssh -O exit $alias)"
  elif print -r -- "$r" | grep -q 'users:(("sshd'; then
    ok "remote 127.0.0.1:$port is our ssh forward"
  elif print -r -- "$r" | grep -q 'users:(('; then
    bad "remote 127.0.0.1:$port is held by another process of yours, not sshd: $(print -r -- "$r" | grep -o 'users:.*')"
  else
    # sshd holds forwards in a process ss can't attribute to you; signed responses guard the rest.
    ok "remote 127.0.0.1:$port listening (owner not visible; responses are signature-checked below)"
  fi

  local rl
  rl=$("${SSH[@]}" -T "$alias" '"$SHELL" -lic "for n in xclip xsel pbpaste; do printf \"which %s %s\n\" \$n \"\$(command -v \$n)\"; done; printf \"claude %s\n\" \"\$(claude --version 2>/dev/null)\"" 2>/dev/null' || true)
  local n got
  for n in xclip xsel pbpaste; do
    got=$(print -r -- "$rl" | sed -n "s/^which $n //p" | tail -1)
    [[ $got == */.local/bin/$n ]] && ok "$n -> $got" || bad "$n resolves to '${got:-nothing}' in a login shell (want ~/.local/bin/$n; re-login or check ~/.zshrc)"
  done
  local cv
  cv=$(print -r -- "$rl" | sed -n 's/^claude //p' | tail -1)
  # Claude Code builds that read the clipboard natively could skip xclip; the harness is the real test.
  [[ -n $cv ]] && ok "claude $cv (after a Claude update, recheck with: scripts/spike/run.sh $alias --real)"

  # Someone else on the same account: a shell without the key must not reach the Mac at all.
  local before after rc_other
  before=$(grep -c "pull host=$alias " "$HOME/Library/Logs/clipbridge.log" 2>/dev/null || true)
  rc_other=$("${SSH[@]}" -T "$alias" "env -u LC_CLIPBRIDGE -u TMUX \"\$SHELL\" -lic 'pbpaste >/dev/null 2>&1; echo rc=\$?' 2>/dev/null" | sed -n 's/^rc=//p' | tail -1)
  sleep 0.5
  after=$(grep -c "pull host=$alias " "$HOME/Library/Logs/clipbridge.log" 2>/dev/null || true)
  if [[ ${before:-0} == "${after:-0}" && $rc_other != 0 ]]; then
    ok "a shell without your session key can't read the clipboard"
  else
    bad "a shell without the session key reached the Mac (pulls ${before:-0}->${after:-0}, rc=$rc_other)"
  fi

  if [[ -n $mac_kind ]]; then
    local cmd
    [[ $mac_kind == image ]] && cmd='xclip -selection clipboard -t image/png -o' || cmd='pbpaste'
    local rs
    rs=$("${SSH[@]}" -T "$alias" "\"\$SHELL\" -lic '$cmd | sha256sum' 2>/dev/null" | grep -oE '^[0-9a-f]{64}' | tail -1 || true)
    [[ $rs == "$mac_sum" ]] && ok "round trip ($mac_kind) sha256 matches" || bad "round trip ($mac_kind): mac $mac_sum, remote ${rs:-none}"
  fi

  (( fail )) && exit 1
  [[ -z $mac_kind ]] && { print "nothing-to-test: copy an image or text and rerun"; exit 3; }
  exit 0
}

# ---------------------------------------------------------------- main

case ${1:-} in
  install) cmd_install ;;
  add) shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  rotate) shift; cmd_rotate "$@" ;;
  new) shift; cmd_new "$@" ;;
  hostkey) shift; cmd_hostkey "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  pause) cmd_pause ;;
  resume) cmd_resume ;;
  status) cmd_status ;;
  version | --version) print "clipbridge $(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || print dev)" ;;
  *) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
