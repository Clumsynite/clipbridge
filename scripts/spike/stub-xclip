#!/usr/bin/env python3
# Spike stub: logs argv, serves a fixed 16x16 PNG for image requests.
import base64
import os
import sys
import time

PNG = base64.b64decode(
    "iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAFklEQVR4nGOQq7hDEmIY1TCqYfhqAAD2K3IQoc2C5QAAAABJRU5ErkJggg=="
)
log = os.path.expanduser("~/.cache/cb-spike/log")
with open(log, "a") as f:
    f.write("%d %s\n" % (time.time(), " ".join(sys.argv[1:])))
args = sys.argv[1:]
t = args[args.index("-t") + 1] if "-t" in args and args.index("-t") + 1 < len(args) else None
if "-o" not in args:
    sys.exit(1)
if t == "TARGETS":
    sys.stdout.write("TARGETS\nimage/png\n")
elif t and t.startswith("image/"):
    sys.stdout.buffer.write(PNG)
else:
    sys.exit(1)
